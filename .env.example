# Set to your canonical production URL (e.g. https://arunsr.dev)
# Vercel also sets VERCEL_URL automatically if this is omitted.
NEXT_PUBLIC_SITE_URL=

# Spotify "last played" line. Create an app at https://developer.spotify.com/dashboard
# with the redirect URI http://127.0.0.1:8888/callback, then run
#   SPOTIFY_CLIENT_ID=… SPOTIFY_CLIENT_SECRET=… node scripts/spotify-token.mjs
# and paste the refresh token it prints. Leave these empty to hide the line.
# Using ngrok instead? Run `ngrok http 8888`, register https://<id>.ngrok-free.app/callback,
# and add SPOTIFY_REDIRECT_URI=<that URL> to the command above.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Leaves cracked by every visitor. Add Upstash Redis from the Vercel Marketplace
# (Storage → Upstash → Redis); it sets these for you. Leave empty to hide the line.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
